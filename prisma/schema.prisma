generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        Int      @id @default(autoincrement())
  name      String
  code      String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  invites InviteToken[]
}

// ============ USERS ============
model User {
  id              Int           @id @default(autoincrement())
  email           String        @unique
  username        String?       @unique
  password        String
  passwordHash    String?
  passwordVisible String?
  name            String
  role            String        @default("EMPLOYEE")
  permissionsJson String?
  tokenVersion    Int           @default(0)
  isActive        Boolean       @default(true)
  orgId           Int?
  organization    Organization? @relation(fields: [orgId], references: [id])
  emailVerifiedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  leaveRequests                LeaveRequest[]
  paymentRequests              PaymentRequest[]
  payments                     Payment[]
  subscription                 Subscription?
  warehouseRequests            WarehouseRequest[]
  warehouseTasks               WarehouseTask[]
  stockMovements               StockMovement[]
  purchaseOrders               PurchaseOrder[]
  binAuditSessions             BinAuditSession[]
  discrepanciesClosed          StockDiscrepancy[]       @relation("DiscrepancyClosedBy")
  receivingDiscrepanciesClosed ReceivingDiscrepancy[]   @relation("ReceivingDiscrepancyClosedBy")
  invitesCreated               InviteToken[]            @relation("InviteCreatedBy")
  passwordResetTokens          PasswordResetToken[]
  revisionsCreated             StockRevision[]          @relation("RevisionCreatedBy")
  revisionItemsApplied         StockRevisionItem[]      @relation("RevisionItemAppliedBy")
  receivingLinesCreated        WarehouseReceivingLine[] @relation("ReceivingLineCreatedBy")
  receivingLinesPlaced         WarehouseReceivingLine[] @relation("ReceivingLinePlacedBy")
  assignedOrders               SalesOrder[]             @relation("OrderAssignedTo")
  passportPrintedOrders        SalesOrder[]             @relation("OrderPassportPrintedBy")
  shippedOrders                SalesOrder[]             @relation("OrderShippedBy")
  orderPickSkipsCreated        SalesOrderPickSkip[]     @relation("OrderPickSkipCreatedBy")
  orderPickSkipsRestored       SalesOrderPickSkip[]     @relation("OrderPickSkipRestoredBy")
  orderStatusHistoryEvents     OrderStatusHistory[]     @relation("OrderStatusHistoryActor")

  @@index([orgId])
}

// ============ SUBSCRIPTION ============
model Subscription {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  plan           String
  status         String
  paidUntil      DateTime?
  trialStartedAt DateTime?
  trialUsed      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InviteToken {
  id              Int           @id @default(autoincrement())
  email           String
  orgId           Int?
  organization    Organization? @relation(fields: [orgId], references: [id])
  tokenHash       String        @unique
  role            String
  expiresAt       DateTime
  usedAt          DateTime?
  createdByUserId Int
  createdBy       User          @relation("InviteCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime      @default(now())

  @@index([orgId])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ HR ============
model Employee {
  id                  Int                  @id @default(autoincrement())
  orgId               Int?
  fullName            String
  position            String
  department          String
  telegramChatId      String?
  status              String               @default("ACTIVE") // ACTIVE / FIRED
  hiredAt             DateTime             @default(now())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  birthDate           DateTime?
  leaveRegionCategory LeaveRegionCategory  @default(STANDARD)
  annualLeaveDays     Int                  @default(28)
  leaveOverrideDays   Int?
  leaveApplications   HrLeaveApplication[]
  safetyAssignments   SafetyAssignment[]
}

model HrLeaveApplication {
  id         Int      @id @default(autoincrement())
  orgId      Int?
  employeeId Int
  type       String // PAID / UNPAID / TERMINATION
  startDate  DateTime
  endDate    DateTime
  days       Int
  status     String   @default("GENERATED")
  reason     String?
  docText    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id])
}

model SafetyInstruction {
  id          Int                @id @default(autoincrement())
  orgId       Int?
  title       String
  description String?
  role        String?
  createdAt   DateTime           @default(now())
  assignments SafetyAssignment[]
}

model SafetyAssignment {
  id             Int               @id @default(autoincrement())
  orgId          Int?
  employeeId     Int
  instructionId  Int
  status         String            @default("PENDING") // PENDING / COMPLETED
  dueDate        DateTime?
  completedAt    DateTime?
  lastReminderAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  employee       Employee          @relation(fields: [employeeId], references: [id])
  instruction    SafetyInstruction @relation(fields: [instructionId], references: [id])
}

// ============ LEAVE ============
model LeaveRequest {
  id        Int      @id @default(autoincrement())
  orgId     Int?
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  type      String
  startDate DateTime
  endDate   DateTime
  status    String   @default("PENDING") // PENDING / APPROVED / REJECTED
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ PAYMENTS ============
model PaymentRequest {
  id          Int       @id @default(autoincrement())
  orgId       Int?
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  title       String
  amount      Float
  currency    String    @default("RUB")
  expenseCode String?
  dueDate     DateTime?
  status      String    @default("NEW") // NEW / APPROVED / PAID / REJECTED
  comment     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Payment {
  id                Int      @id @default(autoincrement())
  orgId             Int?
  userId            Int
  provider          String
  providerPaymentId String
  amount            Float
  currency          String
  status            String
  metadata          Json?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerPaymentId])
}

// ============ WAREHOUSE REQUESTS ============
model WarehouseRequest {
  id        Int      @id @default(autoincrement())
  orgId     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  type        WarehouseRequestType
  desiredDate DateTime?
  comment     String?

  status        WarehouseRequestStatus @default(NEW)
  statusComment String?

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  items WarehouseRequestItem[]

  relatedPaymentId Int?
  relatedDocument  String?
  targetEmployee   String?
}

model WarehouseRequestItem {
  id        Int              @id @default(autoincrement())
  orgId     Int?
  name      String
  quantity  Float
  unit      String?
  requestId Int
  request   WarehouseRequest @relation(fields: [requestId], references: [id])
}

model WarehouseTask {
  id             Int       @id @default(autoincrement())
  orgId          Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  title          String
  description    String?
  dueDate        DateTime?
  status         String    @default("NEW") // NEW / IN_PROGRESS / DONE / CANCELLED
  executorName   String?
  executorChatId String?
  assignerId     Int
  assigner       User      @relation(fields: [assignerId], references: [id])
  lastReminderAt DateTime?
}

enum WarehouseRequestType {
  ISSUE
  RETURN
  INCOME
}

enum WarehouseRequestStatus {
  NEW
  IN_PROGRESS
  DONE
  REJECTED
}

// ============ PURCHASE ORDERS ============
model PurchaseOrder {
  id          Int                 @id @default(autoincrement())
  orgId       Int?
  number      String?
  date        DateTime            @default(now())
  plannedDate DateTime?
  status      PurchaseOrderStatus @default(DRAFT)

  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  comment String?

  items         PurchaseOrderItem[]
  discrepancies ReceivingDiscrepancy[]

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, number])
}

model PurchaseOrderItem {
  id      Int           @id @default(autoincrement())
  orgId   Int?
  orderId Int
  order   PurchaseOrder @relation(fields: [orderId], references: [id])

  itemId Int
  item   Item @relation(fields: [itemId], references: [id])

  quantity    Float
  receivedQty Float @default(0)
  price       Float
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CLOSED
}

enum ReceivingLineStatus {
  PENDING
  PLACED
}

enum ReceivingLineSource {
  RECEIVING
  INVENTORY_PLUS
}

// ============ STOCK ITEMS ============
model Item {
  id                         Int          @id @default(autoincrement())
  orgId                      Int?
  name                       String
  sku                        String?
  barcode                    String?
  qrCode                     String?
  unit                       String?
  minStock                   Float?
  maxStock                   Float?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
  defaultPrice               Float?
  category                   ItemCategory @default(STOCK)
  autoReorderEnabled         Boolean      @default(false)
  autoReorderMin             Float?
  autoReorderSupplierId      Int?
  autoReorderSupplier        Supplier?    @relation(fields: [autoReorderSupplierId], references: [id])
  autoReorderContactName     String?
  autoReorderContactEmail    String?
  autoReorderMessage         String?
  autoReorderActive          Boolean      @default(false)
  autoReorderLastTriggeredAt DateTime?
  autoReorderLastReminderAt  DateTime?
  autoReorderLastOrderId     Int?

  movements              StockMovement[]
  purchaseOrderItems     PurchaseOrderItem[]
  placements             WarehousePlacement[]
  discrepancies          StockDiscrepancy[]
  receivingDiscrepancies ReceivingDiscrepancy[]
  revisionItems          StockRevisionItem[]
  receivingLines         WarehouseReceivingLine[]
  salesOrderLines        SalesOrderLine[]
  pickSkips              SalesOrderPickSkip[]

  @@unique([orgId, sku])
  @@unique([orgId, barcode])
  @@unique([orgId, qrCode])
}

model WarehouseLocation {
  id        Int      @id @default(autoincrement())
  orgId     Int?
  name      String
  zone      String?
  aisle     String?
  rack      String?
  level     String?
  code      String?  @unique
  qrCode    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  placements     WarehousePlacement[]
  auditEvents    BinAuditEvent[]
  discrepancies  StockDiscrepancy[]
  revisionItems  StockRevisionItem[]
  receivingLines WarehouseReceivingLine[]
  pickSkips      SalesOrderPickSkip[]
}

model WarehouseReceivingLine {
  id             Int                 @id @default(autoincrement())
  orgId          Int?
  itemId         Int
  item           Item                @relation(fields: [itemId], references: [id])
  qty            Int
  remainingQty   Int
  manufacturedAt DateTime
  expiresAt      DateTime
  status         ReceivingLineStatus @default(PENDING)
  sourceType     ReceivingLineSource @default(RECEIVING)
  discrepancyId  Int?
  discrepancy    StockDiscrepancy?   @relation(fields: [discrepancyId], references: [id])
  locationId     Int?
  location       WarehouseLocation?  @relation(fields: [locationId], references: [id])
  createdAt      DateTime            @default(now())
  createdById    Int?
  createdBy      User?               @relation("ReceivingLineCreatedBy", fields: [createdById], references: [id])
  placedAt       DateTime?
  placedById     Int?
  placedBy       User?               @relation("ReceivingLinePlacedBy", fields: [placedById], references: [id])

  @@index([status])
  @@index([itemId])
  @@index([locationId])
}

model WarehousePlacement {
  id         Int      @id @default(autoincrement())
  orgId      Int?
  itemId     Int
  locationId Int
  qty        Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  item     Item              @relation(fields: [itemId], references: [id])
  location WarehouseLocation @relation(fields: [locationId], references: [id])

  @@unique([itemId, locationId])
}

model StockMovement {
  id             Int               @id @default(autoincrement())
  orgId          Int?
  opId           String?           @unique
  type           StockMovementType
  itemId         Int
  item           Item              @relation(fields: [itemId], references: [id])
  locationId     Int?
  fromLocationId Int?
  toLocationId   Int?
  quantity       Float
  comment        String?
  pricePerUnit   Float?
  refType        String?
  refId          String?
  createdAt      DateTime          @default(now())
  createdById    Int?
  createdBy      User?             @relation(fields: [createdById], references: [id])
}

model BinAuditSession {
  id              Int                   @id @default(autoincrement())
  orgId           Int?
  startedByUserId Int?
  startedBy       User?                 @relation(fields: [startedByUserId], references: [id])
  startedAt       DateTime              @default(now())
  finishedAt      DateTime?
  status          BinAuditSessionStatus @default(ACTIVE)
  events          BinAuditEvent[]
  discrepancies   StockDiscrepancy[]
}

model BinAuditEvent {
  id         Int               @id @default(autoincrement())
  orgId      Int?
  sessionId  Int
  session    BinAuditSession   @relation(fields: [sessionId], references: [id])
  locationId Int
  location   WarehouseLocation @relation(fields: [locationId], references: [id])
  checkedAt  DateTime          @default(now())
  result     BinAuditResult
  note       String?
}

model StockDiscrepancy {
  id             Int                      @id @default(autoincrement())
  orgId          Int?
  sessionId      Int?
  session        BinAuditSession?         @relation(fields: [sessionId], references: [id])
  locationId     Int
  location       WarehouseLocation        @relation(fields: [locationId], references: [id])
  itemId         Int
  item           Item                     @relation(fields: [itemId], references: [id])
  expectedQty    Int
  countedQty     Int
  delta          Int
  status         StockDiscrepancyStatus   @default(OPEN)
  createdAt      DateTime                 @default(now())
  closedAt       DateTime?
  closedByUserId Int?
  closedByUser   User?                    @relation("DiscrepancyClosedBy", fields: [closedByUserId], references: [id])
  closeNote      String?
  movementOpId   String?
  revisionItems  StockRevisionItem[]
  receivingLines WarehouseReceivingLine[]
}

model StockRevision {
  id              Int                 @id @default(autoincrement())
  orgId           Int?
  createdAt       DateTime            @default(now())
  createdByUserId Int?
  createdBy       User?               @relation("RevisionCreatedBy", fields: [createdByUserId], references: [id])
  items           StockRevisionItem[]
}

model StockRevisionItem {
  id                  Int               @id @default(autoincrement())
  orgId               Int?
  revisionId          Int
  revision            StockRevision     @relation(fields: [revisionId], references: [id])
  discrepancyId       Int?
  discrepancy         StockDiscrepancy? @relation(fields: [discrepancyId], references: [id])
  locationId          Int
  location            WarehouseLocation @relation(fields: [locationId], references: [id])
  itemId              Int
  item                Item              @relation(fields: [itemId], references: [id])
  expectedQty         Int
  countedQty          Int
  delta               Int
  status              String            @default("OPEN")
  appliedAt           DateTime?
  appliedByUserId     Int?
  appliedBy           User?             @relation("RevisionItemAppliedBy", fields: [appliedByUserId], references: [id])
  appliedMovementOpId String?
  note                String?
}

model ReceivingDiscrepancy {
  id              Int                        @id @default(autoincrement())
  orgId           Int?
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder              @relation(fields: [purchaseOrderId], references: [id])
  itemId          Int?
  item            Item?                      @relation(fields: [itemId], references: [id])
  expectedQty     Int
  receivedQty     Int
  delta           Int
  note            String?
  status          ReceivingDiscrepancyStatus @default(OPEN)
  createdAt       DateTime                   @default(now())
  closedAt        DateTime?
  closedByUserId  Int?
  closedByUser    User?                      @relation("ReceivingDiscrepancyClosedBy", fields: [closedByUserId], references: [id])
  closeNote       String?
  movementOpId    String?
}

model OrgProfile {
  id                    Int       @id @default(autoincrement())
  orgId                 Int?
  orgName               String
  legalAddress          String
  actualAddress         String
  inn                   String
  kpp                   String
  phone                 String
  apiKeyHash            String?
  apiKeyHint            String?
  apiKeyLastRotatedAt   DateTime?
  warehouseBootstrapKey String?
  updatedAt             DateTime  @updatedAt

  @@unique([orgId])
}

enum StockMovementType {
  INCOME
  ISSUE
  ADJUSTMENT
}

enum BinAuditSessionStatus {
  ACTIVE
  FINISHED
}

enum BinAuditResult {
  OK
  DISCREPANCY
}

enum StockDiscrepancyStatus {
  OPEN
  CLOSED
}

enum ReceivingDiscrepancyStatus {
  OPEN
  CLOSED
}

enum LeaveRegionCategory {
  STANDARD
  FAR_NORTH
  EQUIVALENT_NORTH
  OTHER_NORTH_COEF
  CUSTOM
}

// ============ SUPPLIERS ============
model Supplier {
  id        Int      @id @default(autoincrement())
  orgId     Int?
  name      String
  inn       String?
  phone     String?
  email     String?
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders           PurchaseOrder[]
  autoReorderItems Item[]
}

model SupplierTruck {
  id     Int                 @id @default(autoincrement())
  orgId  Int?
  status SupplierTruckStatus @default(IN_QUEUE)

  arrivalAt     DateTime  @default(now())
  unloadStartAt DateTime?
  unloadEndAt   DateTime?

  supplier     String?
  orderNumber  String?
  deliveryDate DateTime?

  vehicleBrand String?
  truckNumber  String?
  driverName   String?
  driverPhone  String?
  gate         String?
  cargo        String?
  note         String?
  directImport Boolean @default(false)

  createdAt DateTime @default(now())
}

enum SupplierTruckStatus {
  IN_QUEUE
  UNLOADING
  DONE
}

enum ItemCategory {
  STOCK
  TMC
}

model SalesOrder {
  id                  Int                  @id @default(autoincrement())
  orgId               Int?
  externalOrderId     String?              @unique
  source              String               @default("MANUAL")
  status              SalesOrderStatus     @default(NEW)
  orderNumber         String
  customerName        String
  customerPhone       String?
  shippingAddress     String
  deliveryComment     String?
  assignedToUserId    Int?
  assignedToUser      User?                @relation("OrderAssignedTo", fields: [assignedToUserId], references: [id])
  takenAt             DateTime?
  pickedAt            DateTime?
  packedAt            DateTime?
  completedAt         DateTime?
  boxCode             String?
  boxType             String?
  labelPrintedAt      DateTime?
  passportPrintedAt   DateTime?
  passportPrintCount  Int                  @default(0)
  passportPrintedById Int?
  passportPrintedBy   User?                @relation("OrderPassportPrintedBy", fields: [passportPrintedById], references: [id])
  shippedAt           DateTime?
  shippedByUserId     Int?
  shippedBy           User?                @relation("OrderShippedBy", fields: [shippedByUserId], references: [id])
  carrier             String?
  trackingNumber      String?
  shipNotes           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  lines               SalesOrderLine[]
  pickSkips           SalesOrderPickSkip[]
  statusHistory       OrderStatusHistory[]

  @@index([status])
  @@index([assignedToUserId])
  @@index([passportPrintedById])
  @@index([shippedByUserId])
  @@index([createdAt])
}

model SalesOrderLine {
  id            Int                  @id @default(autoincrement())
  orgId         Int?
  orderId       Int
  order         SalesOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId        Int?
  item          Item?                @relation(fields: [itemId], references: [id])
  requestedSku  String?
  requestedName String?
  qty           Int
  pickedQty     Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  pickSkips     SalesOrderPickSkip[]

  @@index([orderId])
  @@index([itemId])
}

enum SalesOrderStatus {
  NEW
  IN_PICKING
  PICKED
  PACKED
  READY_TO_SHIP
  SHIPPED
  CANCELLED
}

model SalesOrderPickSkip {
  id           Int                      @id @default(autoincrement())
  orgId        Int?
  orderId      Int
  order        SalesOrder               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineId       Int
  line         SalesOrderLine           @relation(fields: [lineId], references: [id], onDelete: Cascade)
  itemId       Int?
  item         Item?                    @relation(fields: [itemId], references: [id])
  locationId   Int?
  location     WarehouseLocation?       @relation(fields: [locationId], references: [id])
  qty          Int                      @default(0)
  reason       String
  comment      String?
  status       SalesOrderPickSkipStatus @default(ACTIVE)
  skippedById  Int?
  skippedBy    User?                    @relation("OrderPickSkipCreatedBy", fields: [skippedById], references: [id])
  restoredById Int?
  restoredBy   User?                    @relation("OrderPickSkipRestoredBy", fields: [restoredById], references: [id])
  restoredAt   DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([orderId, status])
  @@index([lineId, status])
  @@index([itemId])
  @@index([locationId])
}

model OrderStatusHistory {
  id          Int               @id @default(autoincrement())
  orgId       Int?
  orderId     Int
  order       SalesOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  SalesOrderStatus?
  toStatus    SalesOrderStatus
  eventType   String
  actorUserId Int?
  actorUser   User?             @relation("OrderStatusHistoryActor", fields: [actorUserId], references: [id])
  createdAt   DateTime          @default(now())
  metaJson    Json?

  @@index([orgId, createdAt])
  @@index([orgId, orderId, createdAt])
  @@index([orgId, toStatus, createdAt])
}

enum SalesOrderPickSkipStatus {
  ACTIVE
  RESTORED
}
